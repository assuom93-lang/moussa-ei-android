<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde Google (cloud) et transfert vers un nouveau téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
